{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pixel-craft-studio-ten.vercel.app"
        }
      ],
      "destination": "https://www.pixel-craft-studio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-community.xml",
      "destination": "/api/sitemap-community"
    },
    {
      "source": "/p/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Pinterest|Discordbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Redditbot|Embedly|SkypeUriPreview|vkShare|Qwantify|iMessage).*"
        }
      ],
      "destination": "/api/share-meta?type=p&id=:id"
    },
    {
      "source": "/u/:handle",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Pinterest|Discordbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Redditbot|Embedly|SkypeUriPreview|vkShare|Qwantify|iMessage).*"
        }
      ],
      "destination": "/api/share-meta?type=creator&handle=:handle"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
